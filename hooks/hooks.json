{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/protect_brain.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.sh\""
          }
        ]
      }
    ]
  }
}
